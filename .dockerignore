# --- Virtual Environments ---
venv/
.venv/
env/
**/site-packages/

# --- Python Cache ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache/

# --- Environment & Secrets ---
# Crucial: Never include actual secrets in your image
.env
.env.local
**/*.json
!datasets/*.json

# --- Git & Version Control ---
.git/
.gitignore
.dockerignore

# --- IDEs & OS Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Build & Temporary Artifacts ---
build/
dist/
*.egg-info/
*.log
tmp/
temp/

# Let the required code through, ignore local app logs
backend/logs/
backend/medify_debug.log


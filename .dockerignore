# --- Python & Dependencies ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.ipynb_checkpoints/
venv/
.venv/
env/
# Ignore local installed packages
**/site-packages/

# --- Environment & Secrets ---
# Crucial: Never include actual secrets in your image
.env
.env.local
.env.*
!.env.example
# Google Cloud Service Account Keys
**/*.json
!datasets/*.json # Only if you have non-secret JSON in datasets

# --- Git & Version Control ---
.git/
.gitignore
.dockerignore
.gitattributes

# --- Project Metadata & IDEs ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker & CI/CD ---
docker-compose.yml
render.yaml
Dockerfile
**/Dockerfile

# --- Build & Temporary Artifacts ---
build/
dist/
*.egg-info/
*.log
*.out
*.err
tmp/
temp/

# Application Logs
backend/logs/
backend/medify_debug.log
*.log